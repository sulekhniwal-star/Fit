# ==============================================================================
# FitKarma Environment Configuration Template (.env.example)
#
# IMPORTANT:
# 1. Copy this file to `.env` for local client development.
# 2. NEVER commit `.env` or any file containing real credentials to version control.
# 3. Only PUBLIC client configuration should be supplied to the Flutter application.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC CLIENT CONFIGURATION (Consumed by Flutter App via AppConfig)
# ------------------------------------------------------------------------------
# Application Environment: development | staging | production
APP_ENV=development

# Supabase Project URL & Public Anon Key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Sentry DSN for crash reporting (PII scrubbing enforced)
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Optional Feature Flags & Local Overrides
ENABLE_ANALYTICS=false

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY SECRETS (FORBIDDEN IN CLIENT BUILDS)
#
# WARNING: The following secrets are strictly SERVER-ONLY.
# They MUST NEVER be added to the Flutter application build, --dart-define,
# or client bundle. Doing so will trigger a SecurityViolationException.
# They are managed strictly in Supabase Edge Functions / Secret Manager.
# ------------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=ey... (SERVER ONLY)
# RAZORPAY_KEY_ID=rzp_test_... (SERVER / PUBLIC CHECKOUT)
# RAZORPAY_KEY_SECRET=... (SERVER ONLY)
# RAZORPAY_WEBHOOK_SECRET=... (SERVER ONLY)
# GROQ_API_KEY=gsk_... (SERVER ONLY)
# WHATSAPP_ACCESS_TOKEN=EA... (SERVER ONLY)
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=... (SERVER ONLY)

